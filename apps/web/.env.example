# ── Database ───────────────────────────────────────────────────────────────
# Leave DATABASE_URL unset to use the embedded PGlite PostgreSQL (data in ./.data/pglite).
# Set it to use a real PostgreSQL 15+ server:
# DATABASE_URL=postgres://vitra:vitra@localhost:5432/vitra
# PGLITE_DIR=./.data/pglite

# ── Secrets (placeholders — generate your own: `openssl rand -hex 32`) ─────
SESSION_SECRET=replace-with-64-hex-chars
CV_SERVICE_TOKEN=replace-with-shared-token-also-set-on-cv-service
DEVICE_INGEST_SECRET=replace-with-device-ingest-secret

# ── Services ───────────────────────────────────────────────────────────────
CV_SERVICE_URL=http://127.0.0.1:8001
STORAGE_DIR=./storage

# ── Seeded demo accounts (dev only; change before any shared deployment) ───
SEED_ADMIN_PASSWORD=vitra-admin
SEED_CLINICIAN_PASSWORD=vitra-clinician
SEED_OPERATOR_PASSWORD=vitra-operator
SEED_RESEARCHER_PASSWORD=vitra-researcher
