# ── Database ───────────────────────────────────────────────────────────────
# Production / shared deployments: a real PostgreSQL 15+ server via DATABASE_URL (primary path).
#   Local:  DATABASE_URL=postgres://vitra:vitra@localhost:5432/vitra
#   Neon / Vercel Postgres:  DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# Then run once against it:  npm run db:migrate && npm run db:seed
# (db:migrate, db:seed and models:bootstrap read this file, like `next dev` does.)
# DATABASE_URL=
# TLS: ?sslmode=require in the URL, or PGSSLMODE=require, or DATABASE_SSL=true (DATABASE_SSL wins).
# Certificates are verified; set DATABASE_SSL_REJECT_UNAUTHORIZED=false only for a provider with a private CA.
# DATABASE_SSL=
# DATABASE_POOL_MAX=8
#
# Without DATABASE_URL: embedded PGlite (PostgreSQL compiled to WASM) for local development.
# PGLITE_DIR=./.data/pglite
# On Vercel without DATABASE_URL the app falls back to a TEMPORARY demo database in /tmp
# (auto-migrated and seeded per instance, wiped on cold start). Force that mode elsewhere with:
# VITRA_EPHEMERAL_DEMO=1

# ── Secrets (placeholders — generate your own: `openssl rand -hex 32`) ─────
SESSION_SECRET=replace-with-64-hex-chars
CV_SERVICE_TOKEN=replace-with-shared-token-also-set-on-cv-service
DEVICE_INGEST_SECRET=replace-with-device-ingest-secret

# ── Services ───────────────────────────────────────────────────────────────
CV_SERVICE_URL=http://127.0.0.1:8001
STORAGE_DIR=./storage

# ── Seeded demo accounts (dev only; change before any shared deployment) ───
SEED_ADMIN_PASSWORD=vitra-admin
SEED_CLINICIAN_PASSWORD=vitra-clinician
SEED_OPERATOR_PASSWORD=vitra-operator
SEED_RESEARCHER_PASSWORD=vitra-researcher
