{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "typeRoots": ["/opt/npm-tools/node_modules/@types", "./types-offline"],
    "types": ["node"],
    "baseUrl": ".", "ignoreDeprecations": "6.0",
    "paths": { "@/*": ["./*"], "*": ["./types-offline/*"] },
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "incremental": false,
    "plugins": []
  },
  "include": ["types-offline/**/*.d.ts", "**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", ".data", "storage", "tests/e2e", ".next", "scripts", "next-env.d.ts"]
}
