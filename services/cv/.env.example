# Shared secret; when set, every request except GET /health must send
# X-Vitra-Service-Token with this value (401 otherwise). Leave empty to disable.
CV_SERVICE_TOKEN=
# Where trained calibration models (<model_id>.joblib + .json) are persisted.
MODEL_STORE_DIR=./models
# Bind address for run.py
CV_HOST=127.0.0.1
CV_PORT=8001
CV_LOG_LEVEL=info
